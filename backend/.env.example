# ─────────────────────────────────────────────────────────────────────────────
# AIuthor Backend — Environment Variables
# Copy this file to .env and fill in your values before running the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-long-random-string-before-production
LOG_LEVEL=INFO

# ── Database (PostgreSQL 16 + pgvector) ──────────────────────────────────────
# Format: postgresql+psycopg2://user:password@host:port/dbname
POSTGRES_USER=aiuthor
POSTGRES_PASSWORD=aiuthor_secret
POSTGRES_DB=aiuthor_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://aiuthor:aiuthor_secret@localhost:5432/aiuthor_db

# ── CORS (comma-separated list of allowed origins) ───────────────────────────
# For local React dev server, keep http://localhost:5173
# For production, replace with your deployed frontend URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Provider (Module 5.0) ────────────────────────────────────────────────
# Active provider: gemini | openai | mock
LLM_PROVIDER=gemini

# Gemini (primary)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (secondary)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Shared tunables
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# ── Embedding Provider (Module 6.0A) ─────────────────────────────────────────
# Active embedding provider: gemini | openai | mock
EMBEDDING_PROVIDER=gemini

# Gemini Embeddings (primary)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI Embeddings (secondary)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# Shared embedding tunables
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32

# ── RAG Vector Store (Module 6.0B) ───────────────────────────────────────────
# All stored chunk vectors MUST have exactly this many dimensions.
# Default 768 matches Gemini text-embedding-004.
# OpenAI embeddings request this same dimension to ensure compatibility.
RAG_VECTOR_DIMENSIONS=768
ALLOW_PGVECTOR_FALLBACK=false

# CHUNK_OVERLAP=64

# Dev-only real agent testing
ENABLE_REAL_AGENT_TEST_API=false

# Dev-only real LangGraph workflow testing (Module 7.1A)
# Set to true ONLY for local manual testing. Keep false in all automated test envs.
ENABLE_REAL_WORKFLOW_TEST_API=false

