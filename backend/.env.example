# ─────────────────────────────────────────────────────────────────────────────
# AIuthor Backend — Environment Variables
# Copy this file to .env and fill in your values before running the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-long-random-string-before-production
LOG_LEVEL=INFO

# ── Database (PostgreSQL 16 + pgvector) ──────────────────────────────────────
# Format: postgresql+psycopg2://user:password@host:port/dbname
POSTGRES_USER=aiuthor
POSTGRES_PASSWORD=aiuthor_secret
POSTGRES_DB=aiuthor_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://aiuthor:aiuthor_secret@localhost:5432/aiuthor_db

# ── CORS (comma-separated list of allowed origins) ───────────────────────────
# For local React dev server, keep http://localhost:5173
# For production, replace with your deployed frontend URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Provider (filled in Module 9 when agents are added) ──────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# LLM_MODEL=gpt-4o

# ── RAG / Embeddings (filled in Module 6) ─────────────────────────────────────
# EMBEDDING_MODEL=text-embedding-3-small
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
